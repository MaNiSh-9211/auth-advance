# auth-advance/.env.example - template (committed). NO real values.
# server/.env
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/auth-advance?retryWrites=true&w=majority
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET
